CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/KSCrash
DEFINES_MODULE = YES
GCC_ENABLE_CPP_EXCEPTIONS = YES
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_TARGET_SRCROOT}/Sources/KSCrashCore/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashDemangleFilter/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashFilters/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashInstallations/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashRecording/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashRecordingCore/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashReportingCore/include" "${PODS_TARGET_SRCROOT}/Sources/KSCrashSinks/include"
OTHER_LDFLAGS = $(inherited) -l"c++" -l"z" -framework "Foundation" -framework "MessageUI" -framework "SystemConfiguration"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/KSCrash
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
